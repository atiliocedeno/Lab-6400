{
  "name": "sony-recipe-ai",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "fast-xml-parser": "^5.11.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-udp": "^4.1.7"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/events": "^3.0.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:iphone": "expo start --tunnel --go",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "start:device": "expo start --dev-client --tunnel",
    "test": "node tests/camera-probe.cjs && node tests/camera-session.cjs",
    "build:iphone": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "license": "GPL-3.0-only"
}
